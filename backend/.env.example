# Connessione al Postgres di Supabase (Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql+psycopg2://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# Project Settings -> API Keys (pulsante "Connect" in alto -> "Set environment variables")
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://xxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json

# Stripe (Dashboard -> Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# URL del frontend, usato per i redirect di Stripe Checkout
FRONTEND_URL=http://localhost:3000

# ImmoScout24 (da compilare quando disponibili le credenziali partner)
IMMOSCOUT_API_KEY=
IMMOSCOUT_API_BASE_URL=

# Resend (resend.com) per la notifica email dei messaggi di contatto.
# Se vuota, i messaggi vengono comunque salvati ma senza invio email.
RESEND_API_KEY=
